{
  "name": "cncnet-yr-client-package-tools",
  "private": true,
  "type": "module",
  "description": "",
  "author": "",
  "license": "ISC",
  "workspaces": [
    "core",
    "build-installer",
    "map-name-case-fix",
    "mix-packer",
    "mpmaps-updater",
    "publish-release",
    "release-asset-uploader",
    "release-tag-validator",
    "version-writer"
  ],
  "scripts": {
    "map-name-case-fix": "npm run start --workspace map-name-case-fix -- --workingDir ../../package",
    "mpmaps-updater": "npm run start --workspace mpmaps-updater -- --workingDir ../../package",
    "mix-packer": "npm run start --workspace mix-packer -- --inDir ../../game-assets --outDir ../../package",
    "version-writer": "npm run start --workspace version-writer -- --workingDir ../../package",
    "build-installer": "npm run start --workspace build-installer -- --workingDir ../../package",
    "release-tag-validator": "npm run start --workspace release-tag-validator",
    "test-release-tag-validator": "npm run test --workspace release-tag-validator",
    "release-asset-uploader": "npm run start --workspace release-asset-uploader",
    "test-release-asset-uploader": "npm run test --workspace release-asset-uploader",
    "publish-release": "npm run start --workspace publish-release",
    "test-publish-release": "npm run test --workspace publish-release"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">= 24"
  }
}
